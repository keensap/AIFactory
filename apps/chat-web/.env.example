# Chat API origin. The default is http://127.0.0.1:8787.
# You can also change this at runtime from Settings inside the app.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Optional bearer token when the API is started with AIFACTORY_API_TOKEN.
# Prefer entering the token in Settings instead of committing it to a file.
# VITE_API_TOKEN=
