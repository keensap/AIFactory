digraph session {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=10,
         pad=0.3, nodesep=0.35, ranksep=0.45];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5,
         color="#94a3b8", fillcolor="#f8fafc", penwidth=1.0, margin="0.14,0.08"];
  edge  [fontname="Helvetica", fontsize=8, color="#475569", arrowsize=0.6];

  row1 [shape=plaintext, label="TURN N\nprocess A", fontcolor="#334155", fontsize=10];
  cli1 [label="REPL\nsessionId = ?", fillcolor="#dbeafe", color="#2563eb"];
  dsh1 [label="dsh process A\nheadless run", fillcolor="#fef3c7", color="#d97706"];
  store1 [label="Session store\ncreate S1", shape=cylinder, fillcolor="#dcfce7", color="#16a34a"];

  row2 [shape=plaintext, label="TURN N+1\nprocess B", fontcolor="#334155", fontsize=10];
  cli2 [label="REPL\nsessionId = S1", fillcolor="#dbeafe", color="#2563eb"];
  dsh2 [label="dsh process B\n--session-id S1", fillcolor="#fef3c7", color="#d97706"];
  store2 [label="Session store\nadopt S1, append", shape=cylinder, fillcolor="#dcfce7", color="#16a34a"];

  cli1 -> dsh1 [label="spawn\nno session id"];
  dsh1 -> store1 [label="persist turn"];
  store1 -> cli1 [xlabel="session event: S1", constraint=false];
  cli1 -> cli2 [label="REPL remembers S1", style=dashed, color="#64748b"];
  cli2 -> dsh2 [label="spawn\n--session-id S1"];
  dsh2 -> store2 [label="load history,\nappend new turn"];
  store2 -> cli2 [xlabel="final: same S1", constraint=false];

  { rank=same; row1; cli1; dsh1; store1; }
  { rank=same; row2; cli2; dsh2; store2; }
}
