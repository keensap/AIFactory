{
  "name": "@aifactory/chat-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat CLI and HTTP/SSE API for DeepSeek Harness",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "chat": "node src/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "test": "node --test test/*.test.ts",
    "api": "node src/api.ts",
    "check:observability": "node scripts/check-observability-imports.mjs",
    "check:observability:strict": "node scripts/check-observability-imports.mjs --strict",
    "check:models": "node scripts/check-model-imports.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "busboy": "^1.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/pg": "^8.23.1"
  }
}
