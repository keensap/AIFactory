# Copy to .env (gitignored) or export these in your shell.
# Headless mode reads DEEPSEEK_API_KEY from the environment, the workspace
# .env, or $DSH_HOME/.env. It does not use a sign-in saved by the web GUI.

DEEPSEEK_API_KEY=

# Optional CLI overrides (safe in .env):
# AIFACTORY_DSH_BIN=/usr/local/bin/dsh
# AIFACTORY_PROFILE=headless
# AIFACTORY_TIMEOUT_MS=120000
# Semantic retrieval via pgvector (OpenAI-compatible embeddings endpoint):
# AIFACTORY_EMBEDDING_URL=http://127.0.0.1:8081/v1
# AIFACTORY_EMBEDDING_MODEL=LFM2.5-Embedding-350M-Q6_K.gguf
# AIFACTORY_EMBEDDING_DIMENSIONS=1024
# AIFACTORY_EMBEDDING_API_KEY=
# AIFACTORY_EMBEDDING_TIMEOUT_MS=30000
# AIFACTORY_EMBEDDING_BATCH_SIZE=32

# Arize Phoenix observability (optional):
# AIFACTORY_PHOENIX_ENABLED=1
# AIFACTORY_PHOENIX_URL=http://127.0.0.1:6006
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# AIFACTORY_PHOENIX_PROJECT_PREFIX=aifactory-
# AIFACTORY_PHOENIX_ENVIRONMENT=local
# AIFACTORY_PHOENIX_RETENTION_HOURS=24
# AIFACTORY_PHOENIX_CAPTURE_CONTENT=0
# AIFACTORY_PHOENIX_CAPTURE_MAX_CHARS=2000
# AIFACTORY_PHOENIX_API_KEY=
# Per-role stage execution timeout (analyzer/author/reviewer):
# AIFACTORY_STAGE_ROLE_TIMEOUT_MS=300000

# DSH_* variables are launch-only: the harness rejects them in .env.
# Prefer AIFACTORY_DSH_BIN above, or export DSH_BIN in your shell.

# PostgreSQL project registry (required for /api/projects):
# DATABASE_URL=postgres://aifactory:<password>@127.0.0.1:5432/aifactory

# HTTP API (optional):
# AIFACTORY_API_HOST=127.0.0.1
# AIFACTORY_API_PORT=8787
# AIFACTORY_API_TOKEN=
# AIFACTORY_CORS_ORIGIN=http://localhost:5173
# AIFACTORY_DATA_DIR=./.data

# ---------------------------------------------------------------------------
# Model providers — one global target for the whole Factory.
# Priority: settings (PATCH /api/settings/models) > these variables > unconfigured.
# Credentials stay in the environment; the database stores only their names.
# ---------------------------------------------------------------------------
# AIFACTORY_MODEL_PROVIDER=llamacpp        # anthropic | openai | llamacpp | ollama | openrouter | <db id>
# AIFACTORY_MODEL=qwen3-8b
# AIFACTORY_MODEL_TEMPERATURE=0.2
# AIFACTORY_MODEL_MAX_TOKENS=4096
# AIFACTORY_MODEL_REASONING_EFFORT=medium
# AIFACTORY_MODEL_FALLBACK=openai:gpt-5,anthropic:claude-sonnet-4-5

# Cloud credentials (only the selected provider's key is passed to the harness).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Per-provider endpoint overrides (AIFACTORY_<ID>_BASE_URL).
# AIFACTORY_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# AIFACTORY_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Direct-path resilience (OpenAI-compatible and Anthropic engines).
# Per-attempt deadline: cloud providers, and local ones (CPU inference is slow).
# AIFACTORY_MODEL_TIMEOUT_MS=120000
# AIFACTORY_MODEL_LOCAL_TIMEOUT_MS=600000
# Retries after the first attempt (retryable failures only; jittered backoff, honours Retry-After).
# AIFACTORY_MODEL_MAX_RETRIES=2
# AIFACTORY_MODEL_LOCAL_MAX_RETRIES=1
# AIFACTORY_MODEL_RETRY_BASE_MS=500
# AIFACTORY_MODEL_RETRY_MAX_MS=15000
# Circuit breaker: consecutive retryable failures before a route opens, and how long it stays open.
# AIFACTORY_MODEL_BREAKER_THRESHOLD=5
# AIFACTORY_MODEL_BREAKER_COOLDOWN_MS=30000

# Restrict model traffic to local providers (llama.cpp, Ollama, ...). Cloud targets are
# rejected when saved and skipped on every routed call.
# AIFACTORY_MODEL_EGRESS=local-only

# Validate the generated harness overlay with `dsh --dump-config` (set 0 to skip).
# AIFACTORY_MODEL_PATCH_VALIDATE=1

# .env lookup: working directory, then nearest parent up to the workspace root
# (a directory containing .git). Real environment variables always win.
# AIFACTORY_DOTENV=/data/AIFactory2/.env

# Logging (structured, async, multi-sink). Defaults: console + rolling file.
# AIFACTORY_LOG_LEVEL=info          # trace|debug|info|warn|error|fatal
# AIFACTORY_LOG_FORMAT=pretty       # pretty|json (console sink)
# AIFACTORY_LOG_FILE=1              # set to 0 to disable the file sink
# AIFACTORY_LOG_DIR=./.data/logs
# AIFACTORY_LOG_RETENTION_DAYS=7
# AIFACTORY_ENV=local

# Observability provider: phoenix | noop (unknown values fall back to noop).
# Default: phoenix when AIFACTORY_PHOENIX_ENABLED is on, otherwise noop.
# AIFACTORY_OBSERVABILITY_PROVIDER=phoenix   # phoenix | noop | memory | <registered>
# Summary cache (shared by every provider) and per-read overall deadline.
# AIFACTORY_OBSERVABILITY_CACHE_TTL_MS=15000
# AIFACTORY_OBSERVABILITY_DEADLINE_MS=3000
# Phoenix per-project provider cap and idle eviction.
# AIFACTORY_PHOENIX_MAX_PROVIDERS=64
# AIFACTORY_PHOENIX_PROVIDER_IDLE_MS=600000

# Optional OTLP logs export (Phoenix ingests traces, not logs). Point this at an
# OTel Collector or a backend that accepts OTLP/HTTP JSON logs.
# AIFACTORY_OTLP_LOGS_URL=http://127.0.0.1:4318
# AIFACTORY_OTLP_LOGS_HEADERS={"Authorization":"Bearer …"}
# AIFACTORY_OTLP_LOGS_TIMEOUT_MS=5000
# Bounded disk spool for PostgreSQL/OTLP sinks during outages.
# AIFACTORY_LOG_SPOOL_DIR=./.data/logs/spool
# AIFACTORY_LOG_SPOOL_MB=64

# Phoenix is optional observability only. These bounds keep a dead/hung Phoenix
# from delaying stage runs or shutdown.
# AIFACTORY_PHOENIX_REQUEST_TIMEOUT_MS=5000
# AIFACTORY_PHOENIX_OTLP_TIMEOUT_MS=5000
# AIFACTORY_PHOENIX_BREAKER_THRESHOLD=3
# AIFACTORY_PHOENIX_BREAKER_COOLDOWN_MS=30000
# AIFACTORY_PHOENIX_SHUTDOWN_TIMEOUT_MS=3000
