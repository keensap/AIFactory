digraph logging {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=10, pad=0.25, nodesep=0.35, ranksep=0.45, compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, color="#94a3b8", fillcolor="#f8fafc", margin="0.12,0.07"];
  edge  [fontname="Helvetica", fontsize=8, color="#475569", arrowsize=0.6];

  subgraph cluster_app {
    label="application thread — hot path, never throws, never awaits"; fontsize=9; fontcolor="#334155"; color="#cbd5e1"; style="rounded,dashed";
    code [label="HTTP · stage runtime · workspace · harness\nlog.info({ event, ...fields })", fillcolor="#dbeafe", color="#2563eb"];
    facade [label="Logger facade (try/catch around everything)\nlevel + per-component overrides · child() = ForContext", fillcolor="#dbeafe", color="#2563eb"];
    enrich [label="Enrichers (AsyncLocalStorage + OTel span)\nrequestId · projectId · stageRunId · role · traceId", fillcolor="#eff6ff", color="#93c5fd"];
    guard [label="Redaction + size caps + serialization\n(pino core)", fillcolor="#eff6ff", color="#93c5fd"];
    queue [label="Bounded ring buffer\ndrop debug first · count drops", fillcolor="#fef3c7", color="#d97706"];
    emerg [label="Emergency sink\nsync stderr, rate-limited", fillcolor="#fee2e2", color="#dc2626"];
  }

  subgraph cluster_worker {
    label="log worker thread — supervised, restartable"; fontsize=9; fontcolor="#334155"; color="#fde68a"; style="rounded,dashed";
    pump [label="Pump\ncredit-based batches", fillcolor="#fef3c7", color="#d97706"];
    sinkA [label="Console sink\npretty / JSON", fillcolor="#f1f5f9", color="#64748b"];
    sinkB [label="Rolling file sink\nJSONL + retention", fillcolor="#f1f5f9", color="#64748b"];
    sinkC [label="PostgreSQL sink\nbatched insert + TTL", fillcolor="#dcfce7", color="#16a34a"];
    sinkD [label="OTLP / Seq / Loki\n(future)", fillcolor="#f3e8ff", color="#7e22ce", style="rounded,dashed,filled"];
    breaker [label="Per-sink isolation\ntimeout · retry/backoff · circuit breaker", fillcolor="#ffedd5", color="#ea580c"];
  }

  super [label="Supervisor (main thread)\nrestart worker with backoff\nself-diagnostics counters", fillcolor="#ffedd5", color="#ea580c"];
  admin [label="Admin/diagnostics API\nsink health · drops · runtime level switch", fillcolor="#e0f2fe", color="#0284c7"];
  viewer [label="Log viewer API\n/api/logs · /api/projects/:id/logs", fillcolor="#e0f2fe", color="#0284c7"];

  code -> facade -> enrich -> guard -> queue;
  facade -> emerg [style=dashed, color="#dc2626", label="facade failure"];
  queue -> pump [label="postMessage batches"];
  pump -> breaker;
  breaker -> sinkA; breaker -> sinkB; breaker -> sinkC; breaker -> sinkD [style=dashed];
  super -> pump [style=dashed, label="spawn / restart"];
  pump -> super [style=dashed, label="exit · stats"];
  super -> emerg [style=dashed, color="#dc2626", label="worker down"];
  super -> admin;
  sinkC -> viewer;
}
