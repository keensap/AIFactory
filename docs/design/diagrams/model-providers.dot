digraph providers {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=10, pad=0.25, nodesep=0.4, ranksep=0.5, compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, color="#94a3b8", fillcolor="#f8fafc", margin="0.12,0.07"];
  edge  [fontname="Helvetica", fontsize=8, color="#475569", arrowsize=0.6];

  subgraph cluster_callers {
    label="callers — every run uses the same target"; fontsize=9; fontcolor="#334155"; color="#cbd5e1"; style="rounded,dashed";
    stage [label="Stage runtime\nanalyzer · author · reviewer", fillcolor="#dbeafe", color="#2563eb"];
    chat [label="Chat", fillcolor="#dbeafe", color="#2563eb"];
    brief [label="Briefing", fillcolor="#dbeafe", color="#2563eb"];
  }

  subgraph cluster_config {
    label="configuration (settings → env → unconfigured)"; fontsize=9; fontcolor="#334155"; color="#cbd5e1"; style="rounded,dashed";
    target [label="Global target\none provider/model", fillcolor="#fef3c7", color="#d97706"];
    registry [label="Provider registry\nmodel_providers · model_catalog", fillcolor="#fef3c7", color="#d97706"];
    discover [label="Explicit discovery\n+ health probe", fillcolor="#fef3c7", color="#d97706"];
  }

  subgraph cluster_runtime {
    label="Phase 2 — applied to the harness"; fontsize=9; fontcolor="#334155"; color="#cbd5e1"; style="rounded,dashed";
    runtime [label="ModelRuntime\nsnapshot · scrub keys · refresh", fillcolor="#dcfce7", color="#16a34a"];
    patch [label="patch overlay (0600)\nllm-pi-ai routes\n+ agent-default-model", fillcolor="#dcfce7", color="#16a34a"];
    harness [label="DshHarness\ndsh --patch", fillcolor="#dcfce7", color="#16a34a"];
    validate [label="dump-config\nvalidation", fillcolor="#dcfce7", color="#16a34a"];
  }

  subgraph cluster_upstream {
    label="upstream (Phase 2 routes)"; fontsize=9; fontcolor="#334155"; color="#cbd5e1"; style="rounded,dashed";
    cloud [label="Anthropic · OpenAI\nOpenRouter", fillcolor="#f1f5f9", color="#64748b"];
    local [label="llama.cpp · Ollama\n127.0.0.1", fillcolor="#f1f5f9", color="#64748b"];
  }

  direct [label="Phase 3 — direct engines\nOpenAI-compatible · Anthropic\n(no agent loop)", fillcolor="#f3e8ff", color="#7e22ce", style="rounded,dashed,filled"];

  stage -> runtime; chat -> runtime; brief -> runtime;
  target -> runtime; registry -> runtime; discover -> registry;
  runtime -> patch -> harness;
  runtime -> validate [style=dashed, label="on refresh"];
  harness -> cloud; harness -> local;
  runtime -> direct [style=dashed];
}
